<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="main_world">

    <!-- Physics -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Scene -->
    <scene>

      <!-- 전체 조명 -->
      <ambient>1 1 1 1</ambient>

      <!-- 하늘 배경 -->
      <background>1 1 1 1</background>

      <!-- 그림자 제거 -->
      <shadows>false</shadows>

    </scene>

    <!-- White Ground -->
    <model name="ground_plane">

      <static>true</static>

      <link name="link">

        <!-- Collision -->
        <collision name="collision">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>

        </collision>

        <!-- Visual -->
        <visual name="visual">

          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>

          <!-- 완전 흰색 -->
          <material>

            <ambient>1 1 1 1</ambient>

            <diffuse>1 1 1 1</diffuse>

            <specular>1 1 1 1</specular>

            <emissive>1 1 1 1</emissive>

          </material>

        </visual>

      </link>

    </model>

    <!-- Square Intersection Map -->
    <include>

      <uri>model://square_intersection_gazebo_map</uri>

      <pose>0 0 0.01 0 0 0</pose>

    </include>

  </world>

</sdf>