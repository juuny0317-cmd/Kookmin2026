    <!-- 화살표: 왼쪽 차선, 아래 방향. shaft + 삼각형 head -->
    <model name="arrow_left_lane_down">
      <static>true</static>
      <pose>-1.75 18 0.07 0 0 3.14159</pose>
      <link name="link">

