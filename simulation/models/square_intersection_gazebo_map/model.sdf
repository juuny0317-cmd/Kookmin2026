<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="square_intersection_gazebo_map">

    <static>true</static>

    <link name="map_link">

      <visual name="asphalt_visual">
        <geometry>
          <mesh>
            <uri>model://square_intersection_gazebo_map/meshes/road_asphalt.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>

      <visual name="white_edge_visual">
        <geometry>
          <mesh>
            <uri>model://square_intersection_gazebo_map/meshes/white_edge_lines.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <visual name="yellow_center_visual">
        <geometry>
          <mesh>
            <uri>model://square_intersection_gazebo_map/meshes/yellow_centerlines.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>

      <visual name="white_detail_visual">
        <geometry>
          <mesh>
            <uri>model://square_intersection_gazebo_map/meshes/white_straight_details.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://square_intersection_gazebo_map/meshes/road_asphalt.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

  </model>

</sdf>