<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="straight_road">
    <static>true</static>

    <link name="road_link">

      <!-- 
        도로 collision:
        pose z = -0.01, size z = 0.02 이므로
        도로 윗면이 정확히 z = 0.0 이 됨.
      -->
      <collision name="road_collision">
        <pose>0 24 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>7 48 0.02</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- 도로 표면: visual 전용 plane -->
      <visual name="road_surface">
        <pose>0 24 0.000 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>7 48</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <!-- 좌측 흰색 경계선 -->
      <visual name="left_edge_line">
        <pose>-3.35 24 0.002 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.12 48</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

