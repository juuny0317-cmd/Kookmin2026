      <!-- 
        화살표 수정:
        기존 화살표는 머리 부분 각도와 위치 때문에 Y자처럼 보였음.
        아래는 진행 방향 기준으로 shaft + V-head가 자연스럽게 이어지도록 수정한 값.
      -->

      <!-- 왼쪽 차선 : 아래 방향 -->

      <!-- shaft -->
      <visual name="arrow_left_shaft">
        <pose>-1.75 18.45 0.004 0 0 0</pose>
        <cast_shadows>false</cast_shadows>

        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.34 1.10</size>
          </plane>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

