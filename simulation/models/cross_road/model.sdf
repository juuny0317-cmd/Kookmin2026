<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="square_intersection_loop">

    <gravity>0 0 -9.80665</gravity>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.5665</latitude_deg>
      <longitude_deg>126.9780</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.75 0.78 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 80 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <direction>-0.45 0.20 -0.87</direction>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Asphalt -->

    <model name="asphalt_road_collision">

      <static>true</static>

      <link name="road_link">

        <collision name="road_collision">

          <geometry>
            <mesh>
              <uri>model://square_intersection_gazebo_map/meshes/road_asphalt.stl</uri>
            </mesh>
          </geometry>

          <surface>

            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>

            <contact>
              <ode>
                <kp>10000000</kp>
                <kd>1</kd>
              </ode>
            </contact>

          </surface>

        </collision>

        <visual name="road_visual">

          <geometry>
            <mesh>
              <uri>model://square_intersection_gazebo_map/meshes/road_asphalt.stl</uri>
            </mesh>
          </geometry>

          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.07 0.07 0.07 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>

        </visual>

      </link>

    </model>

    <!-- Yellow centerlines -->

    <model name="yellow_centerlines">

      <static>true</static>

      <link name="yellow_link">

        <visual name="yellow_visual">

          <geometry>
            <mesh>
              <uri>model://square_intersection_gazebo_map/meshes/yellow_centerlines.stl</uri>
            </mesh>
          </geometry>

          <material>
            <ambient>1.0 0.76 0.0 1</ambient>
            <diffuse>1.0 0.76 0.0 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

    <!-- White edge lines -->

    <model name="white_edge_lines">

      <static>true</static>

      <link name="white_link">

        <visual name="white_visual">

          <geometry>
            <mesh>
              <uri>model://square_intersection_gazebo_map/meshes/white_edge_lines.stl</uri>
            </mesh>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

    <!-- White detailed road markings -->

    <model name="white_details">

      <static>true</static>

      <link name="white_details_link">

        <visual name="white_details_visual">

          <geometry>
            <mesh>
              <uri>model://square_intersection_gazebo_map/meshes/white_straight_details.stl</uri>
            </mesh>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>

        </visual>

      </link>

    </model>

  </world>

</sdf>